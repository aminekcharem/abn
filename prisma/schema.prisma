generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum Transmission {
  MANUELLE
  AUTOMATIQUE
}

enum FuelType {
  ESSENCE
  DIESEL
  HYBRIDE
  ELECTRIQUE
}

enum PriceCurrency {
  TND
  EUR
}

enum VehicleStatus {
  BROUILLON
  DISPONIBLE
  VENDU
  RESERVE
}

enum PurchaseRequestStatus {
  NOUVEAU
  EN_COURS
  TRAITE
}

enum AdminTheme {
  DARK
  LIGHT
}

model AdminUser {
  id                  String    @id @default(cuid())
  email               String    @unique
  password            String
  name                String
  role                AdminRole @default(ADMIN)
  resetTokenHash      String?   @unique
  resetTokenExpiresAt DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  image       String?
  icon        String?   @default("car")
  order       Int       @default(0) @map("sort_order")
  isActive    Boolean   @default(true)
  showOnHomepage Boolean @default(true)
  showOnCategoriesPage Boolean @default(true)
  vehicles    Vehicle[]

  @@index([isActive])
  @@index([showOnHomepage])
  @@index([showOnCategoriesPage])
}

model Brand {
  id            String    @id @default(cuid())
  name          String
  slug          String    @unique
  logo          String?
  countryOrigin String?
  isActive      Boolean   @default(true)
  vehicles      Vehicle[]

  @@index([isActive])
}

model Option {
  id         String         @id @default(cuid())
  name       String
  categoryId String
  category   OptionCategory @relation(fields: [categoryId], references: [id])
  vehicles   Vehicle[]

  @@unique([name, categoryId])
  @@index([categoryId])
}

model OptionCategory {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  iconSvg   String?  @db.Text
  order     Int      @default(0) @map("sort_order")
  isActive  Boolean  @default(true)
  options   Option[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

model Vehicle {
  id           String            @id @default(cuid())
  title        String
  slug         String            @unique
  brandId      String
  categoryId   String
  model        String?
  generation   String?
  trim         String?
  engineCode   String?
  motorization String?
  price        Decimal           @db.Decimal(12, 2)
  priceCurrency PriceCurrency    @default(TND)
  transportIncluded Boolean      @default(true)
  transportPrice Decimal?        @db.Decimal(12, 2)
  transportCurrency PriceCurrency @default(TND)
  year         Int?
  firstRegistrationDate DateTime?
  mileage      Int?
  power        Int?
  displacement String?
  engine       String?
  transmission String?
  fuelType     FuelType?
  gearbox      String?
  color        String?
  registration String?
  vin          String?
  doors        Int?
  seats        Int?
  status       VehicleStatus     @default(DISPONIBLE)
  isFeatured   Boolean           @default(false)
  isNew        Boolean           @default(false)
  description  String?           @db.Text
  images       Json
  videos       Json
  brand        Brand             @relation(fields: [brandId], references: [id])
  category     Category          @relation(fields: [categoryId], references: [id])
  options      Option[]
  requests     PurchaseRequest[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([brandId])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@index([isNew])
  @@index([price])
  @@index([year])
}

model ContactMessage {
  id        String   @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  subject   String
  message   String   @db.Text
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
  @@index([createdAt])
}

model PurchaseRequest {
  id        String                @id @default(cuid())
  fullName  String
  email     String
  phone     String?
  vehicleId String
  message   String?               @db.Text
  financing Boolean               @default(false)
  status    PurchaseRequestStatus @default(NOUVEAU)
  vehicle   Vehicle               @relation(fields: [vehicleId], references: [id])
  createdAt DateTime              @default(now())

  @@index([vehicleId])
  @@index([status])
  @@index([createdAt])
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdAt])
}

model Review {
  id          String   @id @default(cuid())
  firstName   String
  lastName    String
  isAnonymous Boolean  @default(false)
  rating      Int
  message     String   @db.Text
  isPublished Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isPublished])
  @@index([rating])
  @@index([createdAt])
}

model ShowroomSettings {
  id             String     @id @default("main")
  companyName    String     @default("AutoPro Showroom")
  logoUrl        String?
  websiteLogoUrl String?
  authLogoUrl    String?
  logoWidth      Int        @default(160)
  logoHeight     Int        @default(48)
  contactPhone   String     @default("+216 00 000 000")
  contactEmail   String     @default("contact@autopro.test")
  facebookUrl    String?
  instagramUrl   String?
  showFloatingBar Boolean   @default(true)
  adminTheme     AdminTheme @default(DARK)
  updatedAt      DateTime   @updatedAt
}

model HomepageSettings {
  id                   String   @id @default("main")
  heroSlides           Json
  aboutTitle           String   @default("AutoPro Showroom")
  aboutText            String   @db.Text
  categoryOrder        Json
  featuredVehicleIds   Json
  spotlightVehicleId   String?
  spotlightTitle       String   @default("Achetez avec confiance")
  spotlightDescription String   @db.Text
  whyChooseUsTitle     String   @default("Pourquoi nous choisir ?")
  whyChooseUsItems     Json
  showReviews          Boolean  @default(true)
  showFaqs             Boolean  @default(true)
  faqItems             Json
  updatedAt            DateTime @updatedAt
}

model MediaAsset {
  id           String   @id @default(cuid())
  filename     String
  originalName String
  alt          String?
  title        String?
  caption      String?  @db.Text
  mimeType     String
  size         Int
  width        Int?
  height       Int?
  localPath    String   @unique
  publicUrl    String
  source       String?
  createdAt    DateTime @default(now())

  @@index([mimeType])
  @@index([createdAt])
}
